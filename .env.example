# Copy to .env and fill in. Everything below has a working default except
# FINLENS_SEC_USER_AGENT, and every service named here has a permanently-free
# tier. With no credentials at all the pipeline still runs end to end on the
# local filesystem - it just uses a non-semantic embedding stand-in and has no
# LLM, which the /health endpoint tells you about.

# =============================================================================
# REQUIRED
# =============================================================================
# SEC requires a descriptive User-Agent with a real contact address on every
# request. Anonymous or generic agents get blocked at the edge, and the block
# applies to your IP for hours.
# https://www.sec.gov/os/webmaster-faq#developers
FINLENS_SEC_USER_AGENT="FinLens/0.1 (you@example.com)"

# =============================================================================
# LLM - free tiers, tried in order
# =============================================================================
# Gemini Flash: https://aistudio.google.com/apikey  (free, no card)
GOOGLE_API_KEY=
# Groq: https://console.groq.com/keys  (free, no card) - the fallback that
# keeps a long eval run alive when Gemini's rate limit trips.
GROQ_API_KEY=

FINLENS_LLM_PROVIDER=gemini
FINLENS_GEMINI_MODEL=gemini-3.6-flash
FINLENS_GROQ_MODEL=llama-3.3-70b-versatile
# Optional, paid. Only used if FINLENS_LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# =============================================================================
# Object storage - Cloudflare R2 (10 GB free, zero egress, S3 API)
# =============================================================================
# local | s3     `local` writes to data/lake and needs no account.
FINLENS_STORAGE_BACKEND=local
FINLENS_STORAGE_BUCKET=finlens
# Cloudflare dashboard -> R2 -> Manage API Tokens
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# =============================================================================
# Warehouse - BigQuery sandbox (10 GB + 1 TB queries/month free, no card)
# =============================================================================
# duckdb | bigquery
FINLENS_WAREHOUSE_BACKEND=duckdb
FINLENS_DUCKDB_PATH=data/warehouse/finlens.duckdb
# For the bigquery target: `gcloud auth application-default login` first.
GCP_PROJECT=
FINLENS_BIGQUERY_DATASET=finlens
FINLENS_DBT_TARGET=dev

# =============================================================================
# Vector store - Supabase Postgres + pgvector (500 MB free)
# =============================================================================
# duckdb | pgvector
# `pgvector` is what gives you row-level security, which is the governance
# layer. Apply the schema with:
#   psql "$SUPABASE_DB_URL" -f finlens/governance/sql/rls.sql
FINLENS_VECTOR_BACKEND=duckdb
SUPABASE_DB_URL=

# =============================================================================
# Embeddings - local, CPU, free forever
# =============================================================================
# sentence-transformers | hash
# `hash` is a deterministic stand-in with NO semantic meaning, so CI and a
# fresh clone can run the whole pipeline offline. Retrieval quality on it is
# chance, and the eval harness refuses to report retrieval numbers while it is
# active. Do not evaluate on it.
FINLENS_EMBEDDING_PROVIDER=sentence-transformers
FINLENS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
FINLENS_EMBEDDING_DIM=384
FINLENS_CHUNK_TARGET_TOKENS=800
FINLENS_CHUNK_OVERLAP_TOKENS=100

# =============================================================================
# Scale asymmetry - the central design decision, see docs/ARCHITECTURE.md §3
# =============================================================================
# Broad structured coverage, narrow text coverage: retrieval cost scales with
# corpus size and adds little marginal value, while structured coverage is
# cheap and is what makes cross-entity comparison possible.
FINLENS_STRUCTURED_UNIVERSE_SIZE=300
FINLENS_STRUCTURED_YEAR_MIN=2019
FINLENS_TEXT_UNIVERSE='["AAPL","MSFT","NVDA","GOOGL","AMZN","META","INTC","TSLA","AMD","CRM"]'
FINLENS_TEXT_YEAR_MIN=2020
FINLENS_TEXT_ITEMS='["1A","7","7A"]'

# =============================================================================
# API
# =============================================================================
FINLENS_API_HOST=0.0.0.0
FINLENS_API_PORT=8000
# Anonymous callers are unrestricted by default so `make demo` needs no login.
# Turn this on for anything with more than one user.
FINLENS_REQUIRE_AUTH=false
# 32+ bytes. Change this in any real deployment.
FINLENS_JWT_SECRET=dev-only-insecure-change-me-in-production

# =============================================================================
# Observability
# =============================================================================
FINLENS_LOG_LEVEL=INFO
FINLENS_LOG_JSON=false
